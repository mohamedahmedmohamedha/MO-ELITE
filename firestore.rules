rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'mohamedhamed_2022@icloud.com';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.isAdmin == resource.data.isAdmin
      );
      allow delete: if isAdmin();
      match /app/{docId} {
        allow read, write: if isAdmin() || (
          signedIn() && request.auth.uid == uid && get(/databases/$(database)/documents/users/$(uid)).data.status != 'suspended'
        );
      }
    }
  }
}
