rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'mohamedhamed_2022@icloud.com'
;
    }

    match /vortex_study_users_reset_2026/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // A normal user may create only their own non-admin profile.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin != true;

      // Admin can manage profiles. User can update their own profile but cannot
      // promote itself, change status, or alter a pre-existing admin marker.
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.status == resource.data.status
      );

      allow delete: if isAdmin();

      match /app/{docId} {
        allow read, write: if isAdmin() || (
          signedIn()
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/vortex_study_users_reset_2026/$(uid)).data.status != 'suspended'
        );
      }
    }
  }
}
